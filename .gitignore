**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.venv/
venv/
ENV/
env/
**/.venv/
**/venv/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/

