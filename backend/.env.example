# Database SQLite file path
DB_PATH=chatmeet.db

# Storage directory for media uploads and temporary audio files
MEDIA_DIR=media

# Local GGUF model filename for documentation
LLM_MODEL_PATH=Qwen2.5-1.5B-Instruct.Q8_0.gguf

# URL of the local llama.cpp server
LLM_SERVER_URL=http://127.0.0.1:8080

# HTTP request timeout in seconds for LLM generation
LLM_TIMEOUT_SECONDS=300

# Maximum token count per LLM generation call
LLM_MAX_TOKENS=800

# Whisper model name/size for transcription
WHISPER_MODEL=base

# Compute device for Whisper model inference (cpu or cuda)
WHISPER_DEVICE=cpu

# Quantization type for Whisper model inference (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Executable path for ffmpeg
FFMPEG_PATH=ffmpeg

# Executable path for ffprobe
FFPROBE_PATH=ffprobe

# Polling interval in seconds for background processing worker
WORKER_POLL_INTERVAL=2.0

# Enable background worker task in FastAPI application lifespan
ENABLE_BACKGROUND_WORKER=True

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_MB=2000

# generate with python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_INGEST_TOKEN=change-me

# Timeout in seconds before finalizing an abandoned disconnected live session
BOT_DISCONNECT_TIMEOUT_SECONDS=600

# Whether to allow bot ingest token in query string (default False because uvicorn logs query strings)
BOT_ALLOW_QUERY_TOKEN=False

# Live ingestion session limits
MAX_SPEAKERS_PER_MEETING=50
MAX_SESSION_BUFFERED_AUDIO_BYTES=209715200
MAX_SESSION_LENGTH_SECONDS=28800

# Whisper silence and hallucination filtering thresholds
NO_SPEECH_PROB_THRESHOLD=0.6
AVG_LOGPROB_THRESHOLD=-1.0

# Allowed CORS origins for frontend client requests
CORS_ORIGINS=http://localhost:3000
